{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.limontree.ai/schemas/workflow.schema.json",
  "title": "relay workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "purpose", "steps"],
  "properties": {
    "format": { "const": "relay/1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "maxLength": 2000 },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 32 }
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/step" }
    },
    "never_automate": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "what", "source", "sensitivity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "what": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "action", "role", "needs", "expected_result", "reversible"],
      "properties": {
        "id": { "type": "string", "pattern": "^s-[0-9]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "role": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32 },
        "needs": { "enum": ["none", "shell", "browser", "screen"] },
        "expected_result": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "reversible": { "enum": ["yes", "no", "unsure"] },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "inputs_used": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "approval": { "const": "each" }
      }
    }
  }
}
